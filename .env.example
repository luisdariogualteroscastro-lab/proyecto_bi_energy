# Copia este archivo a .env y ajusta los valores.
# Recorda: .env NO debe quedar versionado con secretos reales.
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=bia_datos
PG_SUPERUSER=postgres
PG_SUPERPASSWORD=cambiame

# Credenciales efimeras SOLO para evaluacion local.
PG_ROL_INGESTA_USER=rol_ingesta
PG_ROL_INGESTA_PASSWORD=cambiame
PG_ROL_ANALISTA_USER=rol_analista
PG_ROL_ANALISTA_PASSWORD=cambiame
PG_ROL_AUDITOR_USER=rol_auditor
PG_ROL_AUDITOR_PASSWORD=cambiame

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=cambiame
MINIO_SECRET_KEY=cambiame

KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=mediciones.raw
